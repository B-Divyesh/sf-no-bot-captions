{
  "name": "no-bot-captions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-runtime.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && cargo test",
    "test:frontend": "vitest run",
    "test:e2e": "playwright test",
    "test:model": "node scripts/model-smoke.mjs",
    "model:download": "node scripts/download-model.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
